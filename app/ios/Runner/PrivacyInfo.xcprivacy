<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Privacy Manifest — iOS 17+ wymaga deklaracji jak app uzywa
        wrazliwych API i jakie dane zbiera.
        Dokumentacja: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files

        TYMCZASOWO bez trackingu (google_mobile_ads usuniety z pubspec).
        Gdy wracamy do AdMob, ustaw NSPrivacyTracking=true + dodaj
        TrackingDomains + AdMob CollectedDataTypes.
    -->

    <key>NSPrivacyTracking</key>
    <false/>

    <!--
        Required Reason API — Apple wymaga uzasadnienia dla
        wybranych systemowych API.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults (uzywane przez Hive / shared_preferences) -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- File timestamp (Hive uzywa do zapisu stanu) -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <!-- Disk Space (Hive moze sprawdzac wolne miejsce) -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>

    <!--
        Bez plugin'ow AdMob/Firebase aktualnie nie zbieramy zadnych danych
        uzytkownika ponad to co system iOS ma domyslnie. Stad pusta tablica
        CollectedDataTypes — aplikacja nie zbiera danych.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
</dict>
</plist>
